<Slide style={{
    width: 1280,
    height: 720,
    paddingTop: 20,
    paddingBottom: 20,
    paddingLeft: 60,
    paddingRight: 60,
    background: '#FFFFFF',
    fontFamily: 'PingFang SC, Microsoft YaHei, sans-serif',
}}>

    <Box style={{ height: 104, flexDirection: 'column', justifyContent: 'center', gap: 10 }}>
        <Box style={{ flexDirection: 'row' }}>
            <Box style={{ paddingTop: 4, paddingBottom: 4, paddingLeft: 12, paddingRight: 12, background: '#2E9E7B', borderRadius: 12 }}>
                <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>技术亮点</Text>
            </Box>
        </Box>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1B4F8A', lineHeight: 1.3 }}>系统技术架构</Text>
    </Box>

    <Box style={{ height: 536, flexDirection: 'row', gap: 32 }}>
        <Box style={{ width: 520, height: 536, alignItems: 'center', justifyContent: 'center' }}>
            <Image src="assets/architecture.png" style={{ width: 520, height: 532, objectFit: 'contain' }} />
        </Box>

        <Box style={{ width: 608, height: 536, flexDirection: 'column', gap: 20, justifyContent: 'center' }}>
            <Text style={{ fontSize: 20, color: '#0F172A', lineHeight: 1.5 }}>
                分层解耦、职责单一 —— 调用方向 <span style={{ fontWeight: 'bold', color: '#1B4F8A' }}>routers → services → adapters → 目标数据库</span>
            </Text>

            <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'stretch' }}>
                <Box style={{ width: 4, background: '#1B4F8A', borderRadius: 2 }} />
                <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1B4F8A', lineHeight: 1.4 }}>分层解耦</Text>
                    <Text style={{ fontSize: 15, color: '#475569', lineHeight: 1.5 }}>六层职责清晰：客户端、接入、安全、服务、适配、数据，任一层改动不外溢。</Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'stretch' }}>
                <Box style={{ width: 4, background: '#1B4F8A', borderRadius: 2 }} />
                <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1B4F8A', lineHeight: 1.4 }}>适配器模式</Text>
                    <Text style={{ fontSize: 15, color: '#475569', lineHeight: 1.5 }}>统一 BaseDBAdapter 接口按 db_type 分发，7 类数据源收敛为 5 套实现，新增数据库只需加一个类。</Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'stretch' }}>
                <Box style={{ width: 4, background: '#1B4F8A', borderRadius: 2 }} />
                <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1B4F8A', lineHeight: 1.4 }}>LLM 统一抽象</Text>
                    <Text style={{ fontSize: 15, color: '#475569', lineHeight: 1.5 }}>OpenAI 兼容 / Claude / Ollama 共用一套 chat · stream · ping 接口，换模型不改业务代码。</Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'stretch' }}>
                <Box style={{ width: 4, background: '#1B4F8A', borderRadius: 2 }} />
                <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1B4F8A', lineHeight: 1.4 }}>安全纵深</Text>
                    <Text style={{ fontSize: 15, color: '#475569', lineHeight: 1.5 }}>登录态 → 路由级 → SQL 类型级三层鉴权，写操作落库待确认并二次校验，全程审计留痕。</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.4 }}>DataMind · 数据库 Agent Web 应用</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8', lineHeight: 1.4 }}>01 / 01</Text>
    </Box>

</Slide>
